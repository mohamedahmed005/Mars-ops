<mxCell id="sd23" value="&lt;b style=&quot;font-size:22px&quot;&gt;MARS-OPS: Mission State Diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lifecycle of a Mission: submit, validate, assign, execute, complete or fail (terminal, never retried)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="-330" width="1000" height="50" as="geometry"/></mxCell>
