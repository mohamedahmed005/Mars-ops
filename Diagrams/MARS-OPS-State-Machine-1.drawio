<mxCell id="sd12" value="submitMission(mission, agents)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd2" target="sd3"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="sd13a" value="[activeMission != null] / setFailureReason(&quot;Another mission is already active&quot;)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0;entryY=0.15;" edge="1" parent="1" source="sd3" target="sd8"><mxGeometry x="0.406" relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="-160"/></Array></mxGeometry></mxCell>
<mxCell id="sd13b" value="[!environmentAllows(mission)] / setFailureReason(&quot;Environmental restriction (e.g. Dust Storm)&quot;)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0;entryY=0.35;" edge="1" parent="1" source="sd3" target="sd8"><mxGeometry x="0.383" relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="-120"/></Array></mxGeometry></mxCell>
<mxCell id="sd13c" value="[!agentsAvailableOrCapable] / setFailureReason(&quot;Agent unavailable or lacks capability&quot;)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0;entryY=0.55;" edge="1" parent="1" source="sd3" target="sd8"><mxGeometry x="0.358" relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="-80"/></Array></mxGeometry></mxCell>
<mxCell id="sd13d" value="[!sufficientColonyResources] / setFailureReason(&quot;Insufficient colony-wide resources&quot;)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0;entryY=0.75;" edge="1" parent="1" source="sd3" target="sd8"><mxGeometry x="0.331" relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="-40"/></Array></mxGeometry></mxCell>

<mxCell id="sd14" value="[all checks pass]&lt;br&gt;/ consumeResources()&lt;br&gt;/ markAgentsUnavailable()&lt;br&gt;/ colony.setActiveMission(this)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sd3" target="sd4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sd15" value="start()&lt;br&gt;/ elapsedTime = 0" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd4" target="sd5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sd15b" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;" edge="1" parent="1" source="sd6" target="sd7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sd16" value="advanceTime(1)&lt;br&gt;[elapsedTime &amp;lt; duration AND no failure condition]&lt;br&gt;/ elapsedTime++&lt;br&gt;/ decreaseBattery() &amp;amp; increaseFatigue()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;align=left;labelPosition=right;verticalAlign=middle;exitX=1;exitY=0.25;entryX=1;entryY=0.75;" edge="1" parent="1" source="sd7" target="sd7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="290"/><mxPoint x="1210" y="320"/></Array></mxGeometry></mxCell>

<mxCell id="sd17" value="advanceTime(1) [elapsedTime == duration]&lt;br&gt;/ releaseAgents()&lt;br&gt;/ colony.clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;align=left;labelPosition=right;verticalAlign=middle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sd5" target="sd9"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="sd18" value="Environment changes to Dust Storm&lt;br&gt;/ Comm Disruption&lt;br&gt;/ setFailureReason(&quot;Environmental hazard&quot;)&lt;br&gt;/ releaseAgents()&lt;br&gt;/ colony.clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;align=left;labelPosition=right;verticalAlign=middle;labelBackgroundColor=default;exitX=0.1;exitY=0;entryX=0.1;entryY=1;" edge="1" parent="1" source="sd5" target="sd8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sd19" value="Rover Breakdown / Equipment Failure&lt;br&gt;/ setFailureReason(&quot;Equipment or vehicle damaged&quot;)&lt;br&gt;/ releaseAgents()&lt;br&gt;/ colony.clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;align=left;labelPosition=right;verticalAlign=middle;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sd5" target="sd8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sd20" value="Battery depleted [batteryLevel &amp;lt;= 0]&lt;br&gt;/ setFailureReason(&quot;Insufficient battery&quot;)&lt;br&gt;/ releaseAgents()&lt;br&gt;/ colony.clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;align=left;labelPosition=right;verticalAlign=middle;labelBackgroundColor=default;exitX=0.9;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="sd5" target="sd8"><mxGeometry relative="1" as="geometry"/></mxCell>

