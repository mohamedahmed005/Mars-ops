  <diagram id="sd" name="3 Mission State Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3600" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sd2" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0" y="280" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sd3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="265" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sd4" value="&lt;b&gt;ASSIGNED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="265" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sd5" value="IN_PROGRESS" style="swimlane;html=1;rounded=1;arcSize=8;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=default;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="215" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sd6" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="sd5">
          <mxGeometry x="20" y="72" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sd7" value="&lt;b&gt;Executing&lt;/b&gt;&lt;br&gt;[elapsedTime &amp;lt; duration, no failure]&lt;br&gt;/ elapsedTime++, battery down, fatigue up" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontSize=11;" vertex="1" parent="sd5">
          <mxGeometry x="70" y="50" width="260" height="66" as="geometry" />
        </mxCell>
        <mxCell id="sd8" value="&lt;b&gt;FAILED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="20" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sd9" value="&lt;b&gt;COMPLETED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1450" y="265" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sd10" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1670" y="280" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sd11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1450" y="30" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sd12" value="submitMission(mission, agents)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd2" target="sd3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd13" value="[activeMission != null]&#xa;[environment disallows mission]&#xa;[agent unavailable or incapable]&#xa;[insufficient colony resources]&#xa;/ setFailureReason(...)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="sd3" target="sd8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd14" value="[all checks pass]&#xa;/ consumeResources()&#xa;/ markAgentsUnavailable()&#xa;/ setActiveMission(this)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd3" target="sd4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd15" value="start() / elapsedTime = 0" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd4" target="sd5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd16" value="advanceTime(1)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.25;entryX=1;entryY=0.75;" edge="1" parent="1" source="sd7" target="sd7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="282" />
              <mxPoint x="1060" y="318" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sd17" value="advanceTime(1) [elapsedTime == duration]&#xa;/ releaseAgents()&#xa;/ clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd5" target="sd9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd18" value="Environment change:&#xa;dust storm / comm disruption&#xa;/ releaseAgents(), clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.15;exitY=0;entryX=0.15;entryY=1;" edge="1" parent="1" source="sd5" target="sd8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd19" value="Rover breakdown /&#xa;equipment failure&#xa;/ releaseAgents(), clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sd5" target="sd8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd20" value="[batteryLevel &lt;= 0]&#xa;insufficient battery&#xa;/ releaseAgents(), clearActiveMission()" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;exitX=0.85;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="sd5" target="sd8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd21" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd9" target="sd10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd22" value="terminal state&#xa;(no automatic retry)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="sd8" target="sd11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sd23" value="&lt;b style=&quot;font-size:22px&quot;&gt;MARS-OPS: Mission State Diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lifecycle of a Mission: submit, assign, execute, complete or fail&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="0" y="-90" width="1000" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
