        </mxCell>
        <mxCell id="s116" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#666666;width=60;height=22;fontStyle=1;fontSize=11;" vertex="1" parent="1">
