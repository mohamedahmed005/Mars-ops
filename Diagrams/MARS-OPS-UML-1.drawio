        </mxCell>
        <mxCell id="s110" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#666666;width=60;height=22;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="0" y="520" width="1320" height="178" as="geometry" />
        </mxCell>
        <mxCell id="s111" value="[for each required (ResourceType, reqQty)]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
